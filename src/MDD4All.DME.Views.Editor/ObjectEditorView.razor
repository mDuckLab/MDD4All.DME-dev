@namespace MDD4All.DME.Views.Editor
@using MDD4All.DME.ViewModels.Editor

@{
    RenderFragment content = @<text>
        @if (ViewModel.EditorState.IsExpanded)
        {
            <div class="card-content @CssBackgroundExtension">
                @if (ViewModel.EditorState.CanRenderChildren)
                {
                    @if (this.ViewModel is ComplexObjectEditorViewModel complex)
                    {
                        <ComplexObjectBody ViewModel="complex"
                                           MaxDepth="@MaxDepth"
                                           CurrentDepth="@(CurrentDepth + 1)" />
                    }
                    else if (this.ViewModel is IndexedCollectionEditorViewModel collection)
                    {
                        <IndexedCollectionBody ViewModel="collection"
                                                MaxDepth="@MaxDepth"
                                                CurrentDepth="@(CurrentDepth + 1)" />
                    }
                    else if (this.ViewModel is DictionaryEditorViewModel dictionary)
                    {
                        <DictionaryBody ViewModel="dictionary"
                                        DeleteMode="@ViewModel.EditorState.IsDeleteMode"
                                        MaxDepth="@MaxDepth"
                                        CurrentDepth="@(CurrentDepth + 1)" />
                    }
                }
                else if (this.ViewModel.HasChildNodes)
                {
                    <div class="depth-limit-msg">... Maximale Tiefe erreicht ...</div>
                }
            </div>
        }
    </text>;
}

@if (this.IsReferenceType)
{
    @if (ShowOwnHeader)
    {
        <div class="editor-card @(CurrentDepth == 1 ? "card-root" : "card-indent") @(ViewModel.EditorState.IsDeleteMode ? "delete-mode-active" : "")">

            <EditorHeaderView DataContext="ViewModel"
                              OnAction="this.HandleAction" />

            @content
        </div>
    }
    else
    {
        @content
    }
}
else if (this.ViewModel is PrimitivePropertyViewModel primitive)
{
    <div class="simple-property-row">
        <PrimitivePropertyEditorView ViewModel="primitive" IsCompact="false" />
    </div>
}
