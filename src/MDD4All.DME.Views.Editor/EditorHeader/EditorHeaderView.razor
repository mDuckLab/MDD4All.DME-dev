@namespace MDD4All.DME.Views.Editor
@using MDD4All.DME.ViewModels.Editor
@using MDD4All.UI.Buttons
@using MDD4All.UI.Buttons.Icons

<div class="card-header-grid @(!DataContext.EditorState.ShowExpander ? "no-toggle" : "")" @onclick="@(() => Notify(EditorAction.ToggleExpand))">
    

    <div class="card-title">
        @if (DataContext.EditorState.ShowExpander)
        {
            <div class="expander-icon-right" title="@(DataContext.EditorState.IsExpanded ? "Collapse" : "Expand")">
                @(DataContext.EditorState.IsExpanded ? "▼" : "▶")
            </div>
        }
        else if (DataContext.EditorState.CurrentDepth == 1)
        {
            @* Root card: never shows an arrow, so it only needs a small nudge, not the full slot. *@
            <div class="expander-icon-placeholder"></div>
        }
        else
        {
            @* Not yet initialized: reserve the same width the arrow will take once it appears,
               so the title doesn't jump sideways when the object gets created. *@
            <div class="expander-icon-right"></div>
        }
        @if (Settings.ShowIndexNumbers)
        {
            <small>@DataContext.Level</small>
        }
        @if (Settings.ShowIcons)
        {
            <EditorTreeIcon DataContext="DataContext" />
        }
        @* Nur der Titel bekommt die Ghost-Klasse *@
        <span class="selectable-label @(DataContext.IsNull ? "label-ghost" : "")"
              @onclick="OnSelectLabel"
              @onclick:stopPropagation="DataContext.IsNull">
            @DataContext.Title
        </span>

        @if (DataContext.TypeBadgeText != null && Settings.ShowTypeBadges)
        {
            <span class="type-badge">@DataContext.TypeBadgeText</span>
        }

        @if (DataContext.IsReadOnly && Settings.ShowReadOnlyBadges)
        {
            <span class="readonly-badge">readonly</span>
        }

        @* Das Badge bleibt wie es ist *@
        @* @if (!string.IsNullOrEmpty(State.BadgeText))
        {
            <span class="badge-list">@State.BadgeText</span>
        } *@
    </div>

    <div class="header-controls-right">
        <div class="card-actions">
            @if (DataContext.EditorState.ShowCreateButton)
            {
                <ToolbarButton Action="ToolbarButton.ToolbarAction.Create"
                           OnActionTriggered="@(() => Notify(EditorAction.Create))"
                           Tooltip="Create instance" />
            }
            @if (DataContext.EditorState.ShowAddButton)
            {
                <ToolbarButton Action="ToolbarButton.ToolbarAction.Add"
                           OnActionTriggered="@(() => Notify(EditorAction.Add))"
                           Tooltip="Add element" />
            }
            @if (DataContext.EditorState.ShowDeleteModeButton)
            {
                <ToolbarButton Action="ToolbarButton.ToolbarAction.DeleteMode"
                           IsActive="@DataContext.EditorState.IsDeleteMode"
                           OnActionTriggered="@(() => Notify(EditorAction.ToggleDeleteMode))"
                           Tooltip="@(DataContext.EditorState.IsDeleteMode ? "Disable delete mode" : "Enable delete mode")" />
            }
            @if (DataContext.EditorState.ShowDeleteButton)
            {
                <ToolbarButton Action="ToolbarButton.ToolbarAction.Delete"
                           OnActionTriggered="@(() => Notify(EditorAction.Delete))"
                           Tooltip="Delete instance" />
            }
        </div>

        
    </div>
</div>