<div class="mainGrid">
    <div class="logo">
        <img src="images/Synorvia_logo.png" width="200" style="margin-left: -20px;margin-top:-50px;"/>
    </div>
    <div class="curentDataModel">
        Current Data Model:<br/>
        @if(DataContext.Configuration.CurrentDataModel == null)
        {
            <span class="currentDataModelTitle">Nothing selected.</span>
        }
        else
        {
            <span class="currentDataModelTitle"><i class="bi bi-x-diamond-fill"></i> @DataContext.Configuration.CurrentDataModel.FullTypeName</span>
        }

    </div>
    <div class="dataModelMainHeader">
        Data Model
    </div>
    <div class="dataModelSubHeader">
        Open a data model
    </div>
    <div class="dataModelCommands">
        <div class="commandLink"
             @onclick="OnSelectDataModel">Open a data model</div>
    </div>
    <div class="dataModelRecentHeader">
        Recent Data Models
    </div>
    <div class="dataModelRecentEntries">
        @for(int counter = 0; counter < DataContext.Configuration.RecentDataModels.Count(); counter++)
        {
            int index = counter;
            Configurations.DataModelDescriptor descriptor = DataContext.Configuration.RecentDataModels[index];
            <div class="commandLink"
                 @onclick="() => OnClickRecentDataModelLink(index)">@descriptor.FullTypeName</div>
        }
    </div>

    <div class="dataFileMainHeader">
        Data Editor
    </div>
    <div class="dataFileSubHeader">
        Edit a data file
    </div>
    <div class="dataFileCommands">
        <div class="commandLink"
             @onclick="() => OnCreateNewFileClick()">Create a new file</div>

        <div class="commandLink">Open an existing file</div>
    </div>
    <div class="dataFileRecentHeader">
        Recent Data Files
    </div>
    <div class="dataFileRecentEntries">
        @for (int counter = 0; counter < DataContext.Configuration.RecentDataFiles.Count(); counter++)
        {
            int index = counter;
            Configurations.DataFileDescriptor descriptor = DataContext.Configuration.RecentDataFiles[index];
            <div class="commandLink"
                 @onclick="() => OnClickRecentDataFileLink(index)">
                @descriptor.FilePath
            </div>
        }
    </div>


</div>


