@page "/"
@using MDD4All.DME.Views.DataManager
@using MDD4All.DME.Views.Dialogs
@using MDD4All.DME.Views.Editor

@switch(DataContext.ViewState)
{
    case ViewModels.EViewState.ShowStartPage:
        <StartPageView DataContext="DataFileManager" />
        break;

    case ViewModels.EViewState.ShowEditor:
        <EditorMainView />
        break;

    case ViewModels.EViewState.ShowTypeSelectionView:
        <TypeSelectionView DataContext="DataFileManager" />
        break;

    case ViewModels.EViewState.NewCultureRequested:
        <CultureChangeDialog DataContext="DataContext" />
        break;
}