@using MDD4All.UI.BlazorComponents.Localization
<div>

    <img src="images/Synorvia_icon.png"
        class="btn btn-outline-secondary startButton" 
        @onclick="() => DataContext.ShowStartPageCommand.Execute(null)" />

    <button class="btn btn-outline-primary btn-sm"
            @onclick="() => DataContext.SaveDataFileCommand.Execute(null)">
        <i class="bi bi-save-fill"></i>
        Save
    </button>

    <button class="btn btn-outline-secondary btn-sm"
            @onclick="() => DataContext.SaveDataFileAsCommand.Execute(null)">
        <i class="bi bi-save"></i>
        Save as...
    </button>

    <div class="btn-group" role="group" aria-label="Basic radio toggle button group" style="margin-left:20px;">
        <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked
               @onclick="() => DataContext.ShowRawData = false">
        <label class="btn btn-outline-dark btn-sm" for="btnradio1">Editor</label>

        <input type="radio" class="btn-check" name="btnradio" id="btnradio3" autocomplete="off"
               @onclick="() => DataContext.ShowRawData = true">
        <label class="btn btn-outline-dark btn-sm" for="btnradio3">Raw data</label>
    </div>

    <LanguageSelection />
</div>


