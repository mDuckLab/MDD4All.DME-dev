@using MDD4All.DME.ViewModels
@using MDD4All.DME.ViewModels.Editor
@using MDD4All.DME.ViewModels.DataManager
@using MDD4All.UI.Breadcrumb
@using MDD4All.DME.Views.DataManager
@using MDD4All.UI.BlazorComponents.Tree
@using MDD4All.UI.DataModels.Tree

<div class="workbench-grid">

    @* --- TOP TOOLBAR --- *@
    <header class="top-toolbar">
        <div class="tool-group">
            <EditorMainToolbar DataContext="MainViewModel" />
            @* <DataManagerView ViewModel="MainViewModel.DataManagerViewModel" /> *@
        </div>

        <TreeDisplayToggle @bind-Active="ExplorerSettings.ShowIcons" />

        <EditorDepthStepperView @bind-Value="EditorSettings.MaxDepth" Limit="9" />

        <button class="wb-btn-reset" title="Einstellungen" type="button" @onclick="@(() => MainViewModel.ActiveOverlay = EOverlayState.Settings)">
            <i class="bi bi-gear-fill"></i>
        </button>
    </header>

    @* --- BREADCRUMB AREA --- *@
    <section class="breadcrumb-area">
        @if (MainViewModel.TreeViewModel?.SelectedNodeParentList != null)
        {
            <BreadcrumbView Path="MainViewModel.TreeViewModel.SelectedNodeParentList"
                            TitleSelector="@(node => ((ObjectEditorViewModel)node).Title)" />
        }
    </section>

    @* --- EXPLORER SIDEBAR --- *@
    <aside class="explorer-area">
        <div class="panel-header">Explorer</div>
        <div class="explorer-content">
            @if (MainViewModel.TreeViewModel != null)
            {
                <MvvmTree TNode="ObjectEditorViewModel"
                          DataContext="@MainViewModel.TreeViewModel"
                          SelectedNodeChanged="OnTreeSelectionChange"
                          ShowTreeIcons="@ExplorerSettings.ShowIcons">
                    <TitleTemplate Context="node">@if (ExplorerSettings.ShowIndexNumbers) { @node.Level } @if (ExplorerSettings.ShowIcons) { <EditorTreeIcon DataContext="node" /> }@node.Title</TitleTemplate>
                </MvvmTree>
            }
        </div>
    </aside>

    @* --- INTERACTIVE RESIZER --- *@
    <div class="resizer-handle" @onmousedown="StartResizing"></div>

    @* --- MAIN EDITOR AREA --- *@
    <main class="editor-area">
        @if (MainViewModel.ShowRawData)
        {
            <div class="panel-header">
                Raw Data &nbsp;&nbsp;

                    JSON &nbsp;<div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox"
                               @bind="DataFileManager.DataEditorViewModel!.ShowXml"/> </div>
                    XML

            </div>
            <div class="editor-body">
                <RawDataView DataContext="DataFileManager.DataEditorViewModel" />
            </div>
        }
        else
        {
            <div class="panel-header">Editor</div>
            <div class="editor-body">
                @if (MainViewModel.SelectedEditorViewModel != null)
                {
                    <ObjectEditorView ViewModel="@((ObjectEditorViewModel)MainViewModel.SelectedEditorViewModel)"
                                      MaxDepth="@EditorSettings.MaxDepth"
                                      CurrentDepth="1" />
                }
                else
                {
                    <div class="p-5 text-center text-muted">
                        Please select an item from the explorer to begin editing.
                    </div>
                }
            </div>
        }
    </main>

    <div class="status-bar-area">
        <StatusBarView DataContext="DataFileManager" />
    </div>
</div>
