@page "/"
@namespace MDD4All.DME.App.Wpf
@using MDD4All.DME.ViewModels.DataManager
@using MDD4All.DME.Views.Dialogs
@using MDD4All.DME.Views.Editor
@using MDD4All.DME.Views.Notifications
@using MDD4All.DME.Views.SettingsDialog
@using MDD4All.DME.Views.StartPage

@* Column layout so the notification gets a row of its own instead of covering the content *@
@* Redrawing this page is enough to carry a new language everywhere: a parent render walks
   into its children, and every text is read fresh from the provider on the way. No @key here -
   that would throw the subtree away and rebuild it, which is both more than is needed and
   dangerous while a component below is still handling the very click that switched. *@
<div class="appShell">
    <div class="appContent">
        @* Pages: mutually exclusive main content *@
        @switch (DataContext.ViewState)
        {
            case ViewState.ShowStartPage:
                <StartPageView OnSettingsRequested="@(() => DataContext.ActiveOverlay = OverlayState.Settings)" />
                break;

            case ViewState.ShowEditor:
                <EditorMainView />
                break;
        }
    </div>

    @* Below the content, above nothing - reachable from the start page as well as the editor *@
    <NotificationToast Message="@DataContext.NotificationMessage"
                       IsError="@(DataContext.NotificationSeverity == NotificationSeverity.Error)"
                       OnDismiss="@DataContext.DismissNotification" />
</div>

@* Overlay: needed on every page *@
@switch (DataContext.ActiveOverlay)
{
    case OverlayState.Settings:
        <SettingsDialog OnClose="OnSettingsClose" />
        break;

    case OverlayState.TypeSelection:
        <TypeSelectionView />
        break;

    case OverlayState.ComplexKeyWarning:
        <ComplexKeyWarningDialog />
        break;
}
