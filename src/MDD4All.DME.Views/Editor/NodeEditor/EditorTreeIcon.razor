@namespace MDD4All.DME.Views.Editor
@using MDD4All.Reflection
﻿<span>
    @switch(DataContext.TypeCategory)
    {
        case TypeCategory.None:
            <i class="bi bi-file-earmark-ruled-fill m-1" style="color:#7086C2; font-weight:bold;"> </i>
            break;

        case TypeCategory.IList:
            <i class="bi bi-collection-fill m-1" style="color:#82C181;"></i>
            break;

        case TypeCategory.Array:
            <i class="bi bi-collection-fill m-1" style="color:#3C8F74;"></i>
            break;

        case TypeCategory.IDictionary:
            <i class="bi bi-collection-fill m-1" style="color:#E2A778;"></i>
            break;
        case TypeCategory.Simple:
        case TypeCategory.SimpleNullable:
            <i class="bi bi-square-fill m-1 simpleTypeIcon"></i>
            break;

        default:
            <i class="bi bi-question m-1"></i>
            break;
    }
</span>


